# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# background = 000000
# foreground = ebebeb

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

# keybind = "ctrl+z=close_surface"
# keybind = "ctrl+d=new_split:right"

# Empty values reset the configuration to the default value
# font-family = JetBrains Mono
# font-family = Victor Mono
# font-family = JetBrainsMono Nerd Font Mono
font-size = 15
# font-style = bold
# font-style-bold = heavy

background-opacity = 0.95

command = "/opt/homebrew/bin/fish -li"

window-decoration = false

copy-on-select = clipboard

# send Ctrl+Tab and Ctrl+Shift+Tab to tmux, which has bindings for them;
# unbound, macOS takes them to move focus and the terminal never sees them
keybind = ctrl+tab=csi:27;5;9~
keybind = ctrl+shift+tab=csi:27;6;9~

# Cmd+§ and Cmd+1..9 send Ctrl+0..9, which select tmux windows 0-9
keybind = super+§=csi:27;5;48~
keybind = super+digit_1=csi:27;5;49~
keybind = super+digit_2=csi:27;5;50~
keybind = super+digit_3=csi:27;5;51~
keybind = super+digit_4=csi:27;5;52~
keybind = super+digit_5=csi:27;5;53~
keybind = super+digit_6=csi:27;5;54~
keybind = super+digit_7=csi:27;5;55~
keybind = super+digit_8=csi:27;5;56~
keybind = super+digit_9=csi:27;5;57~

# Cmd+Opt+← and Cmd+Opt+K send Shift+↑, Cmd+Opt+→ and Cmd+Opt+J send Shift+↓,
# which select the previous and next tmux window
keybind = super+alt+arrow_left=csi:1;2A
keybind = super+alt+k=csi:1;2A
keybind = super+alt+arrow_right=csi:1;2B
keybind = super+alt+j=csi:1;2B

# Cmd+K sends Ctrl+Alt+K, which tmux binds to clear the pane and its history;
# Ghostty's own clear_screen does nothing visible inside tmux
keybind = super+k=csi:27;7;107~

