// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "features": {
    "edit_prediction_provider": "copilot"
    // "edit_prediction_provider": "zed"
  },
  "auto_update": false,
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 16,
  // "buffer_font_family": "Victor Mono",
  "buffer_font_family": "Zed Plex Mono",
  // "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "buffer_line_height": "standard",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Zedokai Darker (Filter Spectrum)"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      }
    }
  },
  // "tab_size": 2,
  "cursor_blink": false,
  "format_on_save": "off",
  // "show_whitespaces": "all",
  // "show_whitespaces": "all",
  "wrap_guides": [80, 88, 109, 119],
  "languages": {
    // "*": {
    //   "language_servers": ["typos"]
    // },
    "Gleam": {
      "show_edit_predictions": true
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width"
    },
    "Python": {
      "show_edit_predictions": true,
      "format_on_save": "off",
      "formatter": [
        {
          "external": {
            "command": "black",
            "arguments": ["-"]
          }
        },
        {
          "external": {
            "command": "isort",
            "arguments": ["-"]
          }
        }
      ],
      "language_servers": ["pyright", "python-refactoring", "ruff"]
    },
    "Vue.js": {
      "tab_size": 2
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120
          // "targetVersion": "3.11"
        }
      }
    },
    "typos": {
      "initialization_options": {
        // Path to your typos config file, .typos.toml by default.
        // "config": ".typos.toml",
        // Path to your typos-lsp executable, takes $PATH into account.
        // "path": "typos-lsp",
        // Diagnostic severity within Zed. "Error" by default, can be:
        // "Error", "Hint", "Information", "Warning"
        "diagnosticSeverity": "Hint"
        // Minimum logging level for the LSP, displayed in Zed's logs. "info" by default, can be:
        // "debug", "error", "info", "off", "trace", "warn"
        // "logLevel": "debug",
        // Traces the communication between ZED and the language server. Recommended for debugging only. "off" by default, can be:
        // "messages", "off", "verbose"
        // "trace.server": "verbose"
      }
    }
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/fish",
        // "program": "/bin/zsh",
        "args": ["-li"]
      }
    },
    "copy_on_select": true,
    "line_height": "standard"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "active_line_width": 2
  },
  "unnecessary_code_fade": 0.75
}
