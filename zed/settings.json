// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // undo the AI-first layout: file tree back on the left
  // also check `block` and `sidebar_sied` in `agent`
  "disable_ai": true,
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  // "new_window" maps to MatchSubpaths, which excludes worktree roots from
  // matching, so "zed ." on an already-open project always opened a new
  // window instead of reusing it.
  "cli_default_open_behavior": "existing_window",
  // "cli_default_open_behavior": "new_window",
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 16.0,
  "edit_predictions": {
    "provider": "copilot"
  },
  "auto_update": false,
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "terminal_init_command": "",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "markdown_preview": {
    "max_width": 3582.0
    // "limit_content_width": false
  },

  "markdown_preview_font_size": 16,
  "buffer_font_size": 13.0,
  "buffer_font_family": "RobotoMono Nerd Font Mono",
  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  // "buffer_font_family": "JetBrains Maple Mono",
  // "buffer_font_family": "Lilex Nerd Font Propo",
  // "buffer_font_family": "Lilex Nerd Font Mono",
  // "buffer_font_family": "Lilex",
  // "buffer_font_family": "Menlo",
  // "buffer_font_family": "MesloLGL Nerd Font",
  // "buffer_font_family": "Monaspace Neon",
  // "buffer_font_family": "Victor Mono",
  // "buffer_font_family": "VictorMono Nerd Font Mono",
  // == ~> ~~> ==> !=
  "buffer_line_height": "standard",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    // "dark": "One Dark"
    "dark": "Ayu Dark"
    // "dark": "Ayu Mirage"
    // "dark": "Gruvbox Dark"
    // "dark": "Gruvbox Dark Hard"
    // "dark": "Gruvbox Dark Soft"
    // "dark": "Zedokai"
    // "dark": "Zedokai Classic"
    // "dark": "Zedokai (Filter Octagon)"
    // "dark": "Zedokai (Filter Ristretto)"
    // "dark": "Zedokai (Filter Spectrum)"
    // "dark": "Zedokai (Filter Machine)"
    // "dark": "Zedokai Darker"
    // "dark": "Zedokai Darker Classic"
    // "dark": "Zedokai Darker (Filter Octagon)"
    // "dark": "Zedokai Darker (Filter Ristretto)"
    // "dark": "Zedokai Darker (Filter Spectrum)"
    // "dark": "Zedokai Darker (Filter Machine)"
    // "dark": "zedokai-darkest-machine"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      }
    }
  },
  // "tab_size": 2,
  "cursor_blink": false,
  "format_on_save": "off",
  "show_whitespaces": "all",
  "wrap_guides": [80, 88, 109, 119],
  "languages": {
    "Gleam": {
      "show_edit_predictions": true
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width"
    },
    "Python": {
      "show_edit_predictions": true,
      "format_on_save": "off",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true
      },
      "language_servers": ["pyright", "python-refactoring", "ruff" , "todohighlight"]
    },
    "Vue.js": {
      "tab_size": 2
    },
    "Go": {
      "language_servers": ["gopls", "golangci-lint" , "todohighlight"]
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120
          // "targetVersion": "3.11"
        }
      }
    },
    "typos": {
      "initialization_options": {
        // Path to your typos config file, .typos.toml by default.
        // "config": ".typos.toml",
        // Path to your typos-lsp executable, takes $PATH into account.
        // "path": "typos-lsp",
        // Diagnostic severity within Zed. "Error" by default, can be:
        // "Error", "Hint", "Information", "Warning"
        "diagnosticSeverity": "Hint"
        // Minimum logging level for the LSP, displayed in Zed's logs. "info" by default, can be:
        // "debug", "error", "info", "off", "trace", "warn"
        // "logLevel": "debug",
        // Traces the communication between ZED and the language server. Recommended for debugging only. "off" by default, can be:
        // "messages", "off", "verbose"
        // "trace.server": "verbose"
      }
    },
    "gopls": {
        "initialization_options": {
          "hints": {
              "assignVariableTypes": true,
              "compositeLiteralFields": true,
              "compositeLiteralTypes": true,
              "constantValues": true,
              "functionTypeParameters": true,
              "parameterNames": true,
              "rangeVariableTypes": true
          }
        }
    },
    "golangci-lint": {
      "binary": { "path": "golangci-lint-langserver" },
      "initialization_options": {
        "command": [
          "golangci-lint", "run",
          "--output.json.path=stdout",
          "--issues-exit-code=1",
          "--show-stats=false"
        ]
      }
    },
    "todohighlight": {
      "initialization_options": { "severity": "warning" }
    }
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/fish",
        "args": ["-li"]
      }
    },
    "copy_on_select": true,
    "line_height": "standard"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "active_line_width": 2
  },
  "unnecessary_code_fade": 0.4,

  "agent_servers": {
    "auggie": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },

}
