{
    // Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and
    // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
    // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
    // same ids are connected.
    // Example:
    // "Print to console": {
    //  "prefix": "log",
    //  "body": [
    //      "console.log('$1');",
    //      "$2"
    //  ],
    //  "description": "Log output to console"
    // }
    "try/exc": {
        "prefix": "try/exc",
        "body": [
            "try:",
            "except:",
            "\tpass$1",
        ],
        "description": "try/exc"
    },
    "try/exc Exception": {
        "prefix": "try/exc Exception",
        "body": [
            "try:",
            "except Exception:",
            "\tpass$1",
        ],
        "description": "try/exc Exception"
    },
    "try/exc as errr": {
        "prefix": "try/exc Exception as err",
        "body": [
            "try:",
            "except Exception as err:",
            "\tpass$1",
        ],
        "description": "try/exc Exception as err"
    },
    "try/exc ? as err": {
        "prefix": "try/exc Exception as err",
        "body": [
            "try:",
            "except Exception$1 as err:",
            "\tpass",
        ],
        "description": "try/exc ? as err"
    },
    "Set a breakpoint": {
        "prefix": "ipdb",
        "body": [
            "__import__(\"ipdb\").set_trace()  # FIXME: BREAKPOINT!!!$1"
        ],
        "description": "Set a breakpoint"
    },
    "Nose Focus": {
        "prefix": "focus",
        "body": [
            "from nose_focus import focus",
            "@focus"
        ],
        "description": "Focus a test case"
    }
}
