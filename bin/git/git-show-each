#!/bin/sh
#
# Show the commit of each sha1 passed either as an argument or from stdin.

show_commit() {
    clear
    git show --pretty=fuller --color $ws_flag "${extra_args[@]}" $1 | less -KMRX
    return $?
}

# Split arguments into pass-through flags and SHA1s
extra_args=()
sha1s=()
for arg in "$@"; do
    case "$arg" in
        -*) extra_args+=("$arg") ;;
        *)  sha1s+=("$arg") ;;
    esac
done

# No SHA1s provided? Read them from stdin
if [ ${#sha1s[@]} -eq 0 ]; then
    sha1s=($(cat -))
fi

# Set the whitespace flag
ws_flag="-w"  # ignore whitespace by default

index=0
while [ $index -lt ${#sha1s[@]} ]; do
    trap : INT
    show_commit ${sha1s[$index]}
    if [ $? -eq 0 ]; then
        index=$((index + 1))
        continue
    fi
    trap - INT
    read -p '[r-prev / w-toggle-ws / q-quit / *-next] ' -rsn1 key < /dev/tty
    case "$key" in
        r)
            if [ $index -gt 0 ]; then
                index=$((index - 1))
            fi
            ;;
        w)
            if [ -z "$ws_flag" ]; then
                ws_flag="-w"
            else
                ws_flag=""
            fi
            ;;
        q)
            break
            ;;
        *)
            index=$((index + 1))
            ;;
    esac
done
